# Required
GROQ_API_KEY=gsk_...
GH_USERNAME=your-github-username

# Optional
GH_TOKEN=                      # fine-grained token (read-only) -> includes private activity, higher rate limit
INCLUDE_PRIVATE_REPOS=false    # mention private repo work in posts?
GROQ_MODEL=llama-3.3-70b-versatile
NEWS_PROBABILITY=0.3           # 0..1 chance of weaving in a tech-news angle
LOOKBACK_HOURS=24
AUTHOR_BIO=a developer building things in public
LOWERCASE=true                 # force lowercase (keeps ALL-CAPS screaming words + urls)
# voice/style lives in style.md

# Auto-posting (on by default; a platform is skipped if its keys are blank)
AUTO_POST_X=true
X_MODE=api                     # api = auto (~$0.015/post) | manual = free one-tap link (github issue, actions only)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

AUTO_POST_LINKEDIN=true
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=           # optional, auto-detected
