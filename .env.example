# Required
GROQ_API_KEY=gsk_...
GH_USERNAME=your-github-username

# Optional
GH_TOKEN=                      # personal token so the bot can read your private + org repos (see README)
INCLUDE_PRIVATE_REPOS=true     # private work is used, but repo/company/client names never appear in posts
EXCLUDE_KEYWORDS=timber,ptm    # skip repos whose name or description contains any of these
EXCLUDE_REPOS=                 # or list exact repos: owner/name,owner/name
AUTO_OPTION=work               # which option api modes post automatically: work, news, or meme
GROQ_MODEL=                    # blank = auto-pick the best available groq model
LOOKBACK_HOURS=24
AUTHOR_BIO=a developer building things in public
LOWERCASE=true                 # force lowercase (keeps ALL-CAPS screaming words + urls)
# voice/style lives in style.md

# Auto-posting (on by default; a platform is skipped if its keys are blank)
AUTO_POST_X=true
X_MODE=api                     # api = auto (~$0.015/post) | manual = free one-tap link (github issue, actions only)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

AUTO_POST_LINKEDIN=true
LINKEDIN_MODE=api              # api = auto | manual = free one-tap link (github issue, actions only)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=           # optional, auto-detected
